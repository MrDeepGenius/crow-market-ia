{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "account_type": {
      "type": "string",
      "description": "Whether the user acts as a creator or an affiliate",
      "enum": [
        "creator",
        "affiliate"
      ],
      "default": "creator"
    },
    "first_name": {
      "type": "string",
      "description": "User first name"
    },
    "last_name": {
      "type": "string",
      "description": "User last name"
    },
    "ai_credits": {
      "type": "number",
      "description": "Mensajes de IA disponibles. 1 credito = 1 mensaje. 30 gratis al registrarse.",
      "default": 0
    },
    "plan_tier": {
      "type": "string",
      "description": "Plan de creador activo. free = sin licencia (no puede crear).",
      "enum": [
        "free",
        "bronce",
        "plata",
        "oro",
        "diamante"
      ],
      "default": "free"
    },
    "plan_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de vencimiento del plan de creador"
    },
    "auto_renew": {
      "type": "boolean",
      "description": "Renovacion automatica del plan al vencer",
      "default": false
    },
    "wallet_balance": {
      "type": "number",
      "description": "Saldo en USDT (TRC20) disponible en la billetera para pagar planes, LC y VIP.",
      "default": 0
    },
    "vip_unlocked": {
      "type": "boolean",
      "description": "Pase VIP Total activo: desbloquea el 100% de las comisiones de reventa de licencias.",
      "default": false
    },
    "lc_unlocked_level": {
      "type": "string",
      "description": "Nivel de Licencia Crow desbloqueado por el afiliado para reventa. none = sin nivel.",
      "enum": [
        "none",
        "bronce",
        "plata",
        "oro",
        "diamante"
      ],
      "default": "none"
    },
    "withdrawal_wallet_address": {
      "type": "string",
      "description": "Direccion de billetera USDT guardada por el afiliado para retiros"
    },
    "withdrawal_network": {
      "type": "string",
      "enum": [
        "TRC20",
        "BEP20"
      ],
      "description": "Red de retiro preferida del afiliado"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}